server {
    listen 80;
    server_name imgvault.dev.sonnora.mx;

    location /.well-known/acme-challenge/ {
        root /var/www/astro;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name imgvault.dev.sonnora.mx;

    ssl_certificate /etc/letsencrypt/live/imgvault.dev.sonnora.mx/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/imgvault.dev.sonnora.mx/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/imgvault.dev.sonnora.mx/chain.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    client_max_body_size 60m;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    location /images/ {
        proxy_pass http://10.0.0.6:19000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://10.0.0.6:38321;
        proxy_http_version 1.1;
        proxy_set_header Host 1a10f3ab-b3a4-4069-98e0-278366437721.sentinel.local;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect https://1a10f3ab-b3a4-4069-98e0-278366437721.sentinel.local/ https://imgvault.dev.sonnora.mx/;
    }
}
