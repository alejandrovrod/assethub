# rideshare.dev.sonnora.mx - HTTPS
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name rideshare.dev.sonnora.mx;

    ssl_certificate /etc/letsencrypt/live/rideshare.dev.sonnora.mx/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rideshare.dev.sonnora.mx/privkey.pem;
